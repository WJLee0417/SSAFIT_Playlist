<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:url var="homeUrl" value="/members/me"/>
<header class="site-header">
    <nav class="nav-shell" aria-label="주요 메뉴">
        <a class="brand" href="${frontendOrigin}/playlists">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-wordmark" aria-label="SSAFIT Playlist">
                <span class="brand-ssafit">SSAFIT</span>
                <span class="brand-playlist">Playlist</span>
            </span>
        </a>
        <div class="nav-links">
            <a href="${frontendOrigin}/playlists">플레이리스트</a>
            <a href="${frontendOrigin}/running-records">러닝 기록</a>
            <a href="${frontendOrigin}/running-sessions">러닝 세션</a>
            <c:choose>
                <c:when test="${loggedIn}">
                    <a href="${homeUrl}">마이페이지</a>
                    <form class="nav-form" method="post" action="<c:url value='/logout'/>">
                        <button class="link-button" type="submit">로그아웃</button>
                    </form>
                </c:when>
                <c:otherwise>
                    <a class="link-button nav-cta" href="<c:url value='/login'/>">로그인</a>
                </c:otherwise>
            </c:choose>
        </div>
    </nav>
</header>
