# Copy this file to .env for Docker Compose. Never commit .env.

# Spring profile and backend container port.
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# MySQL container bootstrap. Replace password placeholders in .env only.
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=ssafit_playlist
MYSQL_USER=ssafit
MYSQL_PASSWORD=<set-local-db-password>
MYSQL_ROOT_PASSWORD=<set-local-root-password>

# Backend datasource used inside Docker Compose.
SSAFIT_DB_HOST=mysql
SSAFIT_DB_PORT=3306
SSAFIT_DB_NAME=ssafit_playlist
SSAFIT_DB_USERNAME=ssafit
SSAFIT_DB_PASSWORD=<same-as-MYSQL_PASSWORD>

# Browser-visible origins. Spotify redirect URI must use localhost, not a container name.
FRONTEND_HOST_PORT=5173
FRONTEND_PUBLIC_ORIGIN=http://127.0.0.1:5173
SSAFIT_FRONTEND_ORIGIN=http://127.0.0.1:5173
SSAFIT_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=/api
VITE_JSP_BASE_URL=http://127.0.0.1:5173

# Spotify Developer Dashboard credentials. Put real values in .env only.
SPOTIFY_CLIENT_ID=<spotify-client-id>
SPOTIFY_CLIENT_SECRET=<spotify-client-secret>
SPOTIFY_REDIRECT_URI=http://localhost:5173/api/spotify/oauth/callback
SPOTIFY_AUDIO_FEATURE_ENRICHMENT_ENABLED=false

# Optional external metadata enrichment for Spotify search results.
# Last.fm fills genre tags. GetSongBPM fills BPM and fallback artist genres.
SPOTIFY_METADATA_ENRICHMENT_ENABLED=true
LASTFM_API_KEY=
GETSONG_API_KEY=
