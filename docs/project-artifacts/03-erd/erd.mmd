erDiagram
    MEMBERS ||--|| RUNNING_PROFILES : "FK member_id"
    MEMBERS ||--o{ MUSIC_REVIEWS : "FK member_id"
    MUSIC ||--o{ MUSIC_REVIEWS : "FK music_id"
    MEMBERS ||--o{ PLAYLISTS : "FK owner_id"
    PLAYLISTS ||--o{ PLAYLIST_ITEMS : "FK playlist_id"
    MUSIC ||--o{ PLAYLIST_ITEMS : "FK music_id"
    MEMBERS ||--o{ PLAYLIST_SAVES : "FK member_id"
    PLAYLISTS ||--o{ PLAYLIST_SAVES : "FK playlist_id"
    MEMBERS ||--o{ RECOMMENDATION_LOGS : "FK member_id"
    PLAYLISTS |o--o{ RECOMMENDATION_LOGS : "FK saved_playlist_id"
    MEMBERS ||--o{ AI_RUNNING_REPORTS : "FK member_id"
    MEMBERS ||--o| SPOTIFY_CONNECTIONS : "FK member_id"
    MEMBERS ||--o{ RUNNING_RECORDS : "FK member_id"
    MEMBERS ||--o{ RUNNING_SESSIONS : "FK host_member_id"
    RUNNING_SESSIONS ||--o{ RUNNING_SESSION_PARTICIPANTS : "FK session_id"
    MEMBERS ||--o{ RUNNING_SESSION_PARTICIPANTS : "FK member_id"

    MEMBERS {
        bigint id PK
        varchar login_id UK
        varchar email UK
        varchar nickname
        varchar status
        datetime deleted_at
    }
    RUNNING_PROFILES {
        bigint id PK
        bigint member_id FK_UK
        varchar gender
        tinyint age
        smallint estimated_max_heart_rate_bpm
        smallint target_bpm_min
        smallint target_bpm_max
        smallint target_cadence_min
        smallint target_cadence_max
        varchar preferred_genre
    }
    MUSIC {
        bigint id PK
        varchar title
        varchar artist
        varchar genre
        smallint bpm
        varchar music_energy_level
        varchar source_type
        varchar spotify_track_id UK
        varchar spotify_uri UK
    }
    MUSIC_REVIEWS {
        bigint id PK
        bigint member_id FK
        bigint music_id FK
        tinyint preference_score
        tinyint running_fit_score
    }
    PLAYLISTS {
        bigint id PK
        bigint owner_id FK
        varchar playlist_type
        varchar source_type
        varchar visibility
        varchar title
        varchar spotify_playlist_id UK
        varchar spotify_export_status
        datetime deleted_at
    }
    PLAYLIST_ITEMS {
        bigint id PK
        bigint playlist_id FK
        bigint music_id FK
        int order_no
    }
    PLAYLIST_SAVES {
        bigint id PK
        bigint member_id FK
        bigint playlist_id FK
    }
    RECOMMENDATION_LOGS {
        bigint id PK
        bigint member_id FK
        varchar requested_intensity
        smallint requested_bpm_min
        smallint requested_bpm_max
        json result_summary
        bigint saved_playlist_id FK
    }
    AI_RUNNING_REPORTS {
        bigint id PK
        bigint member_id FK
        varchar report_type
        char input_snapshot_hash
        json input_snapshot_json
        varchar status
    }
    SPOTIFY_CONNECTIONS {
        bigint id PK
        bigint member_id FK_UK
        varchar spotify_user_id UK
        varchar access_token
        varchar refresh_token
        datetime token_expires_at
    }
    RUNNING_RECORDS {
        bigint id PK
        bigint member_id FK
        date record_date
        decimal distance_km
        int duration_seconds
        int pace_seconds_per_km
        smallint average_cadence
        smallint average_heart_rate_bpm
        datetime deleted_at
    }
    RUNNING_SESSIONS {
        bigint id PK
        bigint host_member_id FK
        varchar title
        datetime scheduled_at
        int capacity
        decimal target_distance_km
        int target_pace_seconds_per_km
        varchar status
    }
    RUNNING_SESSION_PARTICIPANTS {
        bigint id PK
        bigint session_id FK
        bigint member_id FK
        datetime joined_at
    }

%% 논리 관계: RUNNING_PROFILES.preferred_genre -> MUSIC.genre
%% 논리 관계: RECOMMENDATION_LOGS.result_summary JSON -> MUSIC.id 목록
%% 논리 관계: AI_RUNNING_REPORTS.input_snapshot_json -> RUNNING_RECORDS / RECOMMENDATION_LOGS 스냅샷
%% 외부 관계: MUSIC.spotify_* / PLAYLISTS.spotify_* / SPOTIFY_CONNECTIONS.spotify_user_id -> Spotify API
