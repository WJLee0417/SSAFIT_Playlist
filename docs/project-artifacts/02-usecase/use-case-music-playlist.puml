@startuml
title 음악/리뷰/플레이리스트 Use Case
left to right direction
skinparam packageStyle rectangle

actor "비회원" as Guest
actor "일반 회원" as Member

Member --|> Guest

rectangle "음악" {
  usecase "UC-008\n음악 조회/검색/정렬\n(FR-008)" as UC008
  usecase "UC-009\n음악 상세 조회\n(FR-009)" as UC009
  usecase "UC-010\n음악 리뷰 관리\n(FR-010)" as UC010
  usecase "UC-025\n내부 음악 등록/수정 권한 확인\n(FR-024)" as UC025 <<partial>>
}

rectangle "플레이리스트" {
  usecase "UC-011\n내부 플레이리스트 CRUD\n(FR-011)" as UC011
  usecase "UC-012\n플레이리스트 수록곡 관리\n(FR-012)" as UC012
  usecase "UC-013\n플레이리스트 저장/취소\n(FR-013)" as UC013
}

Guest --> UC008
Guest --> UC009

Member --> UC010
Member --> UC011
Member --> UC012
Member --> UC013
Member --> UC025

UC009 ..> UC008 : <<include>>
UC010 ..> UC009 : <<include>>
UC012 ..> UC011 : <<include>>
UC013 ..> UC011 : <<include>>

note right of UC025
  /api/music/internal API는 있으나
  관리자 역할/권한 모델은 확인되지 않음.
  관리자 Actor는 사용하지 않는다.
end note
@enduml
