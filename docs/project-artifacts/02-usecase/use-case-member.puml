@startuml
title 회원/인증/러닝 프로필 Use Case
left to right direction
skinparam packageStyle rectangle

actor "비회원" as Guest
actor "일반 회원" as Member

Member --|> Guest

rectangle "회원 및 세션 인증" {
  usecase "UC-001\n회원가입\n(FR-001)" as UC001
  usecase "UC-002\n로그인\n(FR-002)" as UC002
  usecase "UC-003\n로그아웃\n(FR-003)" as UC003
  usecase "UC-004\n회원 정보 조회/수정\n(FR-004)" as UC004
  usecase "UC-005\n러닝 프로필 관리\n(FR-005)" as UC005 <<partial>>
}

Guest --> UC001
Guest --> UC002
Member --> UC003
Member --> UC004
Member --> UC005

UC004 ..> UC002 : <<include>>
UC005 ..> UC002 : <<include>>

note bottom of UC001
  JSP: /join
  API: POST /api/members
end note

note bottom of UC002
  JSP: /login
  API: POST /api/auth/login
  세션 기반 인증
end note

note bottom of UC005
  JSP: /members/me/running-profile
  API: /api/members/me/running-profile
  Vue 전용 화면은 후속 SPA 통합 과제
end note
@enduml
